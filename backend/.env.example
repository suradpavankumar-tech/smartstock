# SmartStock Environment Configuration (Placeholders Only)
PROJECT_NAME="SmartStock Retail Platform"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Default SQLite for local standalone run, or PostgreSQL for production SaaS)
# DATABASE_URL="postgresql://smartstock_user:secure_password@localhost:5432/smartstock_prod"
DATABASE_URL="sqlite:///./smartstock.db"

# Regional Defaults (Karnataka, India)
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"
DEFAULT_LOCALE="kn-IN"

# SmartStock AI Ultra (Optional External LLM Providers — Placeholders Only)
# When unset, SmartStock AI Ultra runs natively on the local SQL-grounded Business Brain + Statistical ML Engine.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_FAST_MODEL="gpt-4o-mini"
OPENAI_REASONING_MODEL="gpt-4o"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FAST_MODEL="gemini-3.8-flash"
GEMINI_REASONING_MODEL="gemini-4-argon"
GEMINI_LITE_MODEL="gemini-3.5-flash-lite"
AI_PROACTIVE_SCAN_INTERVAL_SEC=900
AI_ENABLE_BACKGROUND_MONITOR=true
